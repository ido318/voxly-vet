# ─────────────────────────────────────────────────────────────
# app/.env.example — copy to app/.env.local and fill in values
# ─────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3001
# Optional: enables detailed /api/health DB/env output with Authorization: Bearer <token>
HEALTH_CHECK_TOKEN=
# Optional: comma-separated trusted source IPs allowed to read detailed health output
HEALTH_CHECK_ALLOWED_IPS=

# Supabase (same project as agent/)
# Run `supabase status` after `supabase start` to get local values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev user seed (scripts/seed-dev-user.mjs)
DEV_USER_EMAIL=owner@demo-clinic.local
DEV_USER_PASSWORD=dev-password-change-me

# AI visit summary (server-side only)
OPENAI_API_KEY=
AI_VISIT_SUMMARY_MODEL=gpt-4o-mini
VISIT_SUMMARY_LOCALE=he

# AI SOAP note (voice dictation transcription + structured parsing, server-side only)
# Uses the same OPENAI_API_KEY above.
SOAP_TRANSCRIBE_MODEL=whisper-1
SOAP_PARSE_MODEL=gpt-4o-mini

# Twilio (server-side only)
# Voice webhook logging needs all of these plus APP_BASE_URL above.
# Sending SMS (visit summary/prescription link, manual messages from the client
# card) needs only SID + token + a from-number, and accepts the from-number under
# either name — TWILIO_PHONE_NUMBER is what agent/.env calls the same number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CLINIC_PHONE_NUMBER=
# TWILIO_PHONE_NUMBER=   # accepted as an alias for the line above (SMS only)
# Optional: defaults to seeded clinic 00000000-0000-4000-8000-000000000001
TWILIO_CLINIC_ID=

# Immediate SMS dispatch (server-side only).
# After the dashboard queues an approval/rejection SMS it asks the agent to drain
# the queue at once, instead of leaving the client waiting for the next pg_cron
# tick. JOBS_BEARER_TOKEN must be the SAME value as agent/.env's — it is the
# token the agent checks on POST /jobs/*. Without both, queueing still works and
# the dashboard honestly reports the SMS as queued rather than sent.
AGENT_BASE_URL=https://your-agent.fly.dev
JOBS_BEARER_TOKEN=

# Green Invoice (חשבונית ירוקה) — invoice document + payment link generation
# (server-side only). GREEN_INVOICE_ENV defaults to "sandbox"; set to "live"
# only once online payments are confirmed enabled on the clinic's account.
GREEN_INVOICE_API_KEY_ID=
GREEN_INVOICE_API_KEY_SECRET=
GREEN_INVOICE_ENV=sandbox

# Integration tests (optional)
RUN_INTEGRATION_TESTS=false

# Prompt learning loop — approve/reject routes (server-side only).
# Same values as agent/.env's ELEVENLABS_API_KEY / ELEVENLABS_AGENT_ID.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Comma-separated ElevenLabs regression test IDs
ELEVENLABS_TEST_IDS=
