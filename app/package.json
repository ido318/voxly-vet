{
  "name": "@voxly-vet/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../packages/shared",
    "dev": "next dev",
    "prebuild": "npm run build --prefix ../packages/shared",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run build --prefix ../packages/shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --prefix ../packages/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION_TESTS=true bash scripts/with-supabase-env.sh vitest run tests/integration",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "seed:dev-user": "bash scripts/with-supabase-env.sh node scripts/seed-dev-user.mjs",
    "seed:demo": "bash scripts/with-supabase-env.sh node scripts/seed-demo-data.mjs",
    "seed:all": "npm run seed:dev-user && npm run seed:demo",
    "reset:clinic-data": "node scripts/reset-clinic-data.mjs",
    "setup:clinic-users": "node scripts/setup-clinic-users.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.66",
    "@elevenlabs/elevenlabs-js": "^2.66.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tomer/shared": "*",
    "ai": "^6.0.193",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
