// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`scripts snapshot — 4 נוסחים קבועים > AFTER_HOURS_SCRIPT מכיל 'המרפאה סגורה' + הפנייה לביה"ח 1`] = `"המרפאה סגורה כרגע וד"ר דנה אינה זמינה. אני יכול לקחת פרטים ולקבוע תור או להעביר בקשה שדנה תחזור אליכם כשהמרפאה נפתחת. אם בינתיים מופיע קושי נשימה, התמוטטות, דימום שלא עוצר, חשד להרעלה, בטן נפוחה וקשה, או החמרה חדה — פנו מיד לבית חולים וטרינרי 24/7. רוצים שאבדוק תור קרוב אצל ד"ר דנה?"`;

exports[`scripts snapshot — 4 נוסחים קבועים > EMERGENCY_SCRIPT מכיל הפנייה לבית חולים 1`] = `"מצב החיה נשמע חירום רפואי. פנו עכשיו לבית חולים וטרינרי הפועל 24 שעות באזורכם — אל תמתינו."`;

exports[`scripts snapshot — 4 נוסחים קבועים > ROUTINE_SCRIPT מכיל הצעת תור ואזהרת 'אם מחמיר' 1`] = `"תודה שתיארתם. לא זיהיתי סימנים שמצריכים טיפול חירום, ואשמח לקבוע תור לבדיקה אצל ד"ר דנה — מתי נוח לכם? ואם משהו משתנה או מחמיר — התקשרו אלינו מיד."`;

exports[`scripts snapshot — 4 נוסחים קבועים > URGENT_CALLBACK_SCRIPT מכיל העברה לדנה + אזהרה 1`] = `"קיבלתי, אני מעביר את הפנייה לד"ר דנה עכשיו ומנסה למצוא לכם חלון לשיחה קצרה עוד היום. חשוב: אם המצב מחמיר בינתיים — פנו לבית חולים וטרינרי, אל תמתינו."`;
