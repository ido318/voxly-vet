  {
    "type": "webhook",
    "name": "escalate-to-vet",
    "description": "יוצר פנייה בדשבורד לדנה — לא העברה חיה. לעניינים לא-רפואיים בלבד (חשבונית, תלונה, שאלה שאין לה תשובה). triage-pet-case מבצע escalation פנימי בעצמו; אין לקרוא לשני הכלים על אותה פנייה רפואית. להעברה חיה השתמש ב-request-human-handoff לפי סדר הטיפול.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/escalate-to-vet",
      "method": "POST",
      "request_headers": {
        "Authorization": { "secret_id": "{{ELEVENLABS_TOOLS_SECRET_ID}}" }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "תיאור קצר של הפנייה"
          },
          "urgency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "רמת דחיפות מ-1 (נמוכה) עד 10 (חירום)"
          },
          "phone": {
            "type": "string",
            "description": "חובה: {{system__caller_id}}. אם חסוי/ריק — המספר שהלקוח מסר. בלעדיו דנה לא תדע למי לחזור."
          }
        },
        "required": ["reason", "urgency", "phone"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "request-human-handoff",
    "description": "בודק אם אפשר להעביר את השיחה החיה לדנה. הכלי הזה לא מעביר בעצמו. אם transfer=true — קרא לכלי המערכת Transfer to number עם number. אם transfer=false — מסור רק את result. אם כלי ההעברה נכשל אחרי transfer=true — אמור שהפנייה נרשמה ואל תבטיח שהשיחה עברה. לפי סדר הטיפול: לא אחרי חירום מפורש מ-triage-pet-case.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/request-human-handoff",
      "method": "POST",
      "request_headers": {
        "Authorization": { "secret_id": "{{ELEVENLABS_TOOLS_SECRET_ID}}" }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "תיאור קצר של סיבת הבקשה לאדם"
          },
          "emergency": {
            "type": "boolean",
            "description": "true אם מדובר במצב חירום רפואי"
          },
          "phone": {
            "type": "string",
            "description": "חובה: {{system__caller_id}}. אם חסוי/ריק — המספר שהלקוח מסר. בלעדיו דנה לא תדע למי לחזור."
          },
          "conversation_id": {
            "type": "string",
            "description": "{{system__conversation_id}} — מקשר את הפנייה להקלטה ולתמלול בדשבורד."
          }
        },
        "required": ["phone"]
      }
    }
  },
