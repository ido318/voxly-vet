# Dependencies
node_modules/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Local docs with real infra identifiers — never commit
docs/*.local.md

# Next.js build output
.next/
out/

# TypeScript build artifacts
dist/
*.tsbuildinfo

# Test artifacts
coverage/
.vitest-timestamps/

# Supabase local state
supabase/.temp/
supabase/.branches/

# macOS
.DS_Store

# Editor
.cursor/*
!.cursor/install.sh
.idea/
.vscode/
*.code-workspace

# Claude Code skills — installed content, reproducible from skills-lock.json
.agents/
.claude/skills/
.claude/agents/

# Vercel CLI project link
.vercel/

# Claude Code local settings (may contain tokens)
.claude/settings.local.json

# Git worktrees (Claude Code)
.worktrees/

# Logs
*.log
npm-debug.log*

# npm cache
.npm-cache/
.codex/

# Claude Code brainstorming visual companion
.superpowers/

# Playwright CLI skill — verification screenshots/snapshots, not project artifacts
.playwright-cli/
app/.playwright-cli/

# Auto-regenerated by `next dev` every run — generic boilerplate, not real content
app/AGENTS.md
app/CLAUDE.md

# Local git worktrees used for isolated feature work
.worktrees/
